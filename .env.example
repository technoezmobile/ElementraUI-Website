# =================================================================
# ElementraUI — Environment Variable Configuration Template
# Website: ElementraUI UI Component Marketplace
# Tagline: Discover. Preview. Build.
# =================================================================
#
# NOTE: ElementraUI is 100% local-first and self-contained by default.
# ZERO external APIs, cloud keys, or proprietary secrets are required
# to run the application, browse the catalogue, or preview components.
#
# All variables below are OPTIONAL and have safe default fallbacks.
# Copy this file to '.env' if you wish to customize port or endpoints:
#   cp .env.example .env
# =================================================================

# -----------------------------------------------------------------
# 1. Server Network Configuration (Optional)
# -----------------------------------------------------------------
# Port on which the Vite development or preview server runs.
# Default: 5173 (standard Vite development port)
PORT=5173

# Host binding address.
# Default: localhost (or 127.0.0.1)
# Use 0.0.0.0 if you need to expose the dev server to a local network or Docker container.
HOST=localhost

# -----------------------------------------------------------------
# 2. Asset & Registry Serving Endpoints (Optional)
# -----------------------------------------------------------------
# Base path for serving Shadcn-compatible JSON component registry definitions.
# Default: /r (resolves to public/r/ on local filesystem)
VITE_REGISTRY_BASE_URL=/r

# Base URL path for serving Awesome Components HTML snapshots and preview screenshots.
# Default: /awesome-components (handled dynamically via Vite middleware)
VITE_AWESOME_COMPONENTS_BASE_URL=/awesome-components

# -----------------------------------------------------------------
# 3. Optional External Integrations (Not Required for Local Mode)
# -----------------------------------------------------------------
# Optional upstream sync endpoint if querying a remote component registry.
# If omitted or left blank, ElementraUI uses the bundled local index.
# VITE_UPSTREAM_REGISTRY_URL=

# Optional AI endpoint integration for Prompt Studio and Website Builder.
# If omitted, Prompt Studio operates in client-side prompt template mode.
# VITE_AI_STUDIO_API_KEY=your_optional_api_key_here
