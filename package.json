{
  "name": "elementraui",
  "description": "ElementraUI — UI Component Marketplace: Discover. Preview. Build.",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/bundle-production-assets.js",
    "build:static": "npm run build",
    "validate:assets": "node scripts/validate-catalogue-assets.js",
    "lint": "eslint src",
    "preview": "vite preview",
    "import:catalogue": "node scripts/importer.js",
    "import:awesome": "node scripts/import-awesome-components.js",
    "test:previews": "node scripts/verify-previews.js",
    "test:install": "node scripts/test-installation.js",
    "test:awesome": "node scripts/verify-awesome-components.js",
    "test:ui": "node scripts/verify-phase5-ui.js",
    "test:coverage": "node scripts/verify-browser-previews.js",
    "test:marketplace": "node scripts/verify-phase6-marketplace.js",
    "test:browser": "node scripts/run-browser-audit.js",
    "test:live": "node scripts/verify-isolated-react.js",
    "test:qa": "node scripts/qa-browser-tests.js",
    "test:production": "node scripts/run-production-browser-tests.js",
    "audit:coverage": "node scripts/audit-dataset-health.js"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "framer-motion": "^12.4.7",
    "lucide-react": "^1.16.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sucrase": "^3.35.1",
    "tailwind-merge": "^3.0.2",
    "three": "^0.174.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.0.8",
    "@types/node": "^22.13.4",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@types/three": "^0.174.0",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^10.13.0",
    "playwright": "^1.64.1",
    "tailwindcss": "^4.0.8",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.71.2",
    "vite": "^6.1.0"
  }
}
